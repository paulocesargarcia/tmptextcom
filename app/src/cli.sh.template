#!/bin/bash

# URL por defecto
DEFAULT_URL="http://localhost:8000"
URL=${STORAGE_URL:-$DEFAULT_URL}

usage() {
    echo "Uso: $0 [opciones]"
    echo "Opciones:"
    echo "  -t, --text TEXT      Envía un texto"
    echo "  -f, --file FILE      Envía un archivo"
    echo "  -u, --url  URL       URL del servidor (por defecto: $URL)"
    echo "  -h, --help           Muestra esta ayuda"
    echo ""
    echo "Ejemplos:"
    echo "  $0 -t \"Hola Mundo\""
    echo "  $0 -f documento.pdf"
    echo "  echo \"log de error\" | $0"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -t|--text) TEXT="$2"; shift ;;
        -f|--file) FILE="$2"; shift ;;
        -u|--url)  URL="$2"; shift ;;
        -h|--help) usage ;;
        *) echo "Parámetro desconocido: $1"; usage ;;
    esac
    shift
done

if [ -n "$FILE" ]; then
    if [ ! -f "$FILE" ]; then
        echo "Error: Archivo $FILE no encontrado."
        exit 1
    fi
    curl -s -F "file=@$FILE" "$URL/api/upload"
elif [ -n "$TEXT" ]; then
    curl -s -X POST --data "$TEXT" "$URL/api/upload"
else
    # Intenta leer de stdin si no es una tty
    if [ ! -t 0 ]; then
        curl -s -X POST --data-binary @- "$URL/api/upload"
    else
        echo "Error: No hay contenido para enviar."
        usage
    fi
fi
echo ""
