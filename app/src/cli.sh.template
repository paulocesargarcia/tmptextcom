#!/bin/bash

# URL por defecto
DEFAULT_URL="{{BASE_URL}}"
URL=${STORAGE_URL:-$DEFAULT_URL}

usage() {
    echo "Uso: $0 [opções]"
    echo "Opções:"
    echo "  -t, --text TEXT      Envía un texto"
    echo "  -f, --file FILE      Envía un archivo"
    echo "  -u, --url  URL       URL del servidor (por defecto: $URL)"
    echo "  -h, --help           Muestra esta ayuda"
    echo ""
    echo "Ejemplos:"
    echo "  $0 -t \"Hola Mundo\""
    echo "  $0 -f documento.pdf"
    echo "  echo \"log de erro\" | $0"
    exit 1
}

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -t|--text) TEXT="$2"; shift ;;
        -f|--file) FILE="$2"; shift ;;
        -u|--url)  URL="$2"; shift ;;
        -h|--help) usage ;;
        *) echo "Parâmetro desconocido: $1"; usage ;;
    esac
    shift
done

if [ -n "$FILE" ]; then
    if [ ! -f "$FILE" ]; then
        echo "Error: Archivo $FILE no encontrado."
        exit 1
    fi
    RESPONSE=$(curl -s -F "file=@$FILE" "$URL/api/upload")
elif [ -n "$TEXT" ]; then
    RESPONSE=$(curl -s -X POST --data "$TEXT" "$URL/api/upload")
else
    # Intenta leer de stdin si no es una tty
    if [ ! -t 0 ]; then
        RESPONSE=$(curl -s -X POST --data-binary @- "$URL/api/upload")
    else
        echo "Error: No hay contenido para enviar."
        usage
    fi
fi

if echo "$RESPONSE" | grep -q "\"error\""; then
    echo "$RESPONSE"
else
    FINAL_URL=$(echo "$RESPONSE" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
    EXPIRE=$(echo "$RESPONSE" | sed -n 's/.*"expires_at":"\([^"]*\)".*/\1/p' | sed 's/\([0-9]\{4\}\)-\([0-9]\{2\}\)-\([0-9]\{2\}\)/\3\/\2\/\1/')

    if [ -n "$FINAL_URL" ]; then
        echo "URL: $FINAL_URL"
        echo "EXPIRE: $EXPIRE"
    else
        echo "$RESPONSE"
    fi
fi
